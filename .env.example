# Diese Werte NUR beim Hoster als Umgebungsvariablen setzen – nie ins Frontend, nie öffentlich.

# KI-Gehirn (mindestens eins):
GEMINI_API_KEY=                    # kostenlos: aistudio.google.com → "Get API key"
# VIO_GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_API_KEY=sk-ant-...     # optional, kostenpflichtig (console.anthropic.com)
# VIO_MODEL=claude-sonnet-5-5

# Datensicherung (empfohlen bei Gratis-Servern ohne festen Speicher):
SUPABASE_URL=                      # https://xxxx.supabase.co
SUPABASE_SECRET_KEY=               # sb_secret_... (Project Settings → API Keys)

# Login:
VIO_INITIAL_PASSWORD=              # nur für den ersten Start, min. 10 Zeichen
VIO_USER_NAME=David

# Nur lokal ohne HTTPS:
# VIO_INSECURE_COOKIES=1
